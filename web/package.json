{
  "name": "identitee-web",
  "version": "0.1.0",
  "private": true,
  "description": "Front end of identit.ee (Vite, TypeScript, Preact).",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/sigreturn-labs/identitee-blockchain",
    "directory": "web"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-chunks.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@polkadot/api": "17.0.2",
    "@polkadot/extension-dapp": "0.64.1",
    "@polkadot/types": "17.0.2",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "hash-wasm": "4.12.0",
    "preact": "11.0.1",
    "preact-iso": "2.12.2"
  },
  "devDependencies": {
    "@polkadot/keyring": "14.0.3",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "happy-dom": "21.0.4",
    "puppeteer-core": "25.16.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
