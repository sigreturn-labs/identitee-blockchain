# identitee verification service (tools/src/verifier/main.ts), installed as
# /etc/systemd/system/identitee-verifier.service. See docs/VERIFIER.md and docs/OPERATIONS.md.
#
# People prove they control an email, an account (X, Discord, GitHub, Telegram, Matrix), a website
# or a PGP key, or pass a KYC check at Didit; the service records the attestation (provide_judgement)
# or the fact (grant_fact DocumentChecked) signed by the verifier agent (authority 0, capabilities 3
# = ATTEST_FIELDS | PERSON_FACTS). HTTP on 127.0.0.1:8787 behind nginx (deploy/nginx-verify.conf).
#
# The key and the provider secrets: EnvironmentFile is read by systemd (as root) before the service
# user exists in the process; /etc/identitee/secrets stays 700 root and the service user cannot
# read the phrase file. The verifier removes every secret of its configuration from every log line.
#
# State: /var/lib/identitee-verifier (StateDirectory, 0700, the only writable path): verifier.db,
# the HMAC keys (email.key, telegram.key, matrix.key, pgp.key, didit.key) and the Matrix bot's
# session, sync state and crypto store (matrix/). Backed up nightly by deploy/backup.sh.
#
# Runtime: Node 24 in /opt/identitee/node, tools/ in /opt/identitee/tools (shared with the migrator),
# installed as docs/OPERATIONS.md says: the Matrix native crypto module is downloaded and checked
# against tools/matrix-crypto.sha256 (`npm run verify:native`).

[Unit]
Description=identitee verification service
After=identitee-node.service network-online.target
Wants=network-online.target
# Not Requires=: polkadot.js reconnects to a restarted node by itself, as for the migrator.

[Service]
Type=simple
User=identitee-verifier
Group=identitee-verifier
WorkingDirectory=/opt/identitee/tools
EnvironmentFile=/etc/identitee/secrets/verifier.env
Environment=IDENTITEE_WS=ws://127.0.0.1:9944
Environment=VERIFIER_PORT=8787
Environment=NODE_ENV=production
ExecStart=/opt/identitee/node/bin/node --import tsx src/verifier/main.ts
StateDirectory=identitee-verifier
StateDirectoryMode=0700
Restart=on-failure
RestartSec=15
# The service waits up to 30 s for a submission in flight, and the bots' answers, before exiting.
TimeoutStopSec=60

# Hardening, as the migrator. Not MemoryDenyWriteExecute: V8 is a JIT (and the Matrix native crypto
# module is loaded into it). tsx caches its transpiled files in the private /tmp. Outbound network is
# needed (Resend, X, Discord, GitHub, Telegram, the Matrix homeserver, Didit, keys.openpgp.org, and any
# website for the Web channel), so the address families stay open; the Web channel itself refuses
# private, loopback and reserved addresses.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
