# identitee migration service (tools/src/migrator.ts), installed as
# /etc/systemd/system/identitee-migrator.service. See docs/OPERATIONS.md.
#
# It watches the finalized blocks of the local node for identitee.MigrationRequested, reads the
# identity on the Polkadot/Kusama People Chain (public wss endpoints, outbound only) and sends
# fulfil_migration / reject_migration signed by the migrator agent (MIGRATE capability).
#
# The key: EnvironmentFile is read by systemd (as root) before the service user exists in the
# process; /etc/identitee/secrets stays 700 root and the service user cannot read the phrase file.
# The migrator removes the key from every log line.
#
# Runtime: Node 24 from the official tarball in /opt/identitee/node (SHA-256 checked against
# SHASUMS256.txt), tools/ in /opt/identitee/tools installed with `npm ci --omit=dev`; tsx is a
# runtime dependency (the tools have no build step) and is loaded with `node --import tsx`.

[Unit]
Description=identitee migration service (People Chain -> identitee)
After=identitee-node.service network-online.target
Wants=network-online.target
# Not Requires=: a node restart does not need a migrator restart. polkadot.js reconnects by itself
# and resubscribes to the finalized heads; the blocks finalized meanwhile are read at the next head.
# The nightly backup stops and restarts both itself (deploy/backup.sh).

[Service]
Type=simple
User=identitee-migrator
Group=identitee-migrator
WorkingDirectory=/opt/identitee/tools
EnvironmentFile=/etc/identitee/secrets/migrator.env
Environment=IDENTITEE_WS=ws://127.0.0.1:9944
Environment=NODE_ENV=production
ExecStart=/opt/identitee/node/bin/node --import tsx src/migrator.ts
Restart=on-failure
RestartSec=15
TimeoutStopSec=45

# Hardening. Not MemoryDenyWriteExecute: V8 is a JIT. tsx caches its transpiled files in the
# private /tmp.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
