{
  "name": "identitee-tools",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": "https://github.com/sigreturn-labs/identitee-blockchain",
  "description": "Tooling for the identitee chain: end-to-end scenario, People Chain migration service and verification service.",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "e2e": "tsx src/e2e.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "migrator:selftest": "tsx src/migrator-selftest.ts",
    "verifier:selftest": "tsx src/verifier-selftest.ts",
    "verifier": "tsx src/verifier/main.ts",
    "verify:native": "tsx src/verifier/native.ts",
    "explorer": "tsx src/explorer/main.ts",
    "explorer:selftest": "tsx src/explorer-selftest.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-nodejs": "0.4.0",
    "@polkadot/api": "17.0.2",
    "@polkadot/keyring": "14.0.3",
    "@polkadot/types": "17.0.2",
    "@polkadot/util": "14.0.3",
    "@polkadot/util-crypto": "14.0.3",
    "matrix-bot-sdk": "0.8.0",
    "openpgp": "6.3.2",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
